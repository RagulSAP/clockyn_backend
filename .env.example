# Clockyn backend environment: copy to `.env`, replace every <placeholder>, keep `.env` out of git.
# Generated by scripts/build_env_example.py from the README table and a scan of the code (do not edit by hand:
# edit the README row or the SECTIONS table in that script, then run it again; a test fails when this file is out of date).
# A line starting with # is optional: the value shown is the default or a typical value. Razorpay keys are NOT here: they live in the
# gen_razorpay_key database table. Plan prices and coupons are data too (gen_plans, gen_coupons).

# ============================================================================================================
# 1. REQUIRED TO START
# The service cannot work without these.
# ============================================================================================================

# PostgreSQL connection
DB_HOST=<database host>
DB_PORT=5432
DB_NAME=<database name>
DB_USER=<database user>
DB_PASSWORD=<database password>
DB_SCHEMA=clockyn_dev

# AWS S3
AWS_ACCESS_KEY_ID=<aws access key id>
AWS_SECRET_ACCESS_KEY=<aws secret access key>
AWS_S3_REGION=ap-south-1
S3_BUCKET_NAME=<s3 bucket for photos, videos and chat files>

# ============================================================================================================
# 2. SIGN-IN AND E-MAIL (REQUIRED for OTP, invoices and the welcome e-mail)
# ============================================================================================================

# How users sign in: otp (default) = mobile number + SMS code (MSG91); email = email address + code emailed
# through SES, no SMS is ever sent. Case-insensitive; read by utils/auth_mode.py; the app learns it from GET
# /auth/config. Set it as an App Runner / ECS environment variable.
# USER_AUTH=otp

# AWS SES email. EMAIL_USER is the SES-verified sender address; required when USER_AUTH=email (while the SES
# account is in the sandbox the recipient addresses must be verified too)
AWS_SES_REGION=ap-south-1
EMAIL_USER=<ses-verified sender address>

# SMS OTP
# MSG91_AUTH_KEY=<msg91 auth key>
# MSG91_TEMPLATE_ID=<msg91 sms template id>

# ============================================================================================================
# 3. SECURITY (REQUIRED IN PRODUCTION)
# Recommended production values are written out; leave REQUIRE_AUTH off only on a local machine.
# ============================================================================================================

# Signing key (>= 32 random characters) of the Bearer access tokens issued by POST /auth/validate-otp, POST
# /auth/verify-device-token and POST /auth/register (additive fields access_token, expires_in). Unset or
# shorter than 32 characters: no token is issued or accepted and nothing changes. Changing it signs every user
# out.
AUTH_TOKEN_SECRET=<at least 32 random characters>

# 1/true/yes/on: every non-public route needs a valid Authorization: Bearer token (401 Not authenticated /
# Token expired; 403 for a role, manager-permission or other-organisation / other-user id violation) and
# /ws/chat, /ws/group-chat, /ws/badge need ?token= of the path user (close code 4401).
REQUIRE_AUTH=1

# 1: operator routes demand an operator credential (operator session token, the key, or the legacy x-admin-id
# header while it is enabled); 0: never; unset: follows REQUIRE_AUTH. Recommended in production: 1. /auth/gen-
# admin-users* always demanded a login and still do;
OPERATOR_ENFORCE=1

# 0: the legacy x-admin-id header (an operator's e-mail or phone, no secret) and /ws/support-ops?admin_id= are
# refused; only operator session tokens and the key are accepted. Default 1 (legacy accepted, so an old
# console keeps working during the roll-out). Recommended in production: 0.
OPERATOR_LEGACY_ADMIN_ID=0

# Secret (>= 24 random characters) of the platform-operator routes, sent as header X-Operator-Key (constant-
# time compare, never an app token). For scripts and break-glass access; the console uses the operator session
# token instead. Unset while the header is sent: 503 (fail closed). See core_functions/operator_auth.py.
# OPERATOR_API_KEY=<at least 24 random characters, for scripts and break-glass access>

# Comma list of web origins allowed by CORS, e.g. https://app.example.com,https://admin.example.com. Unset or
# * (default) answers * as before. With a list only listed origins (and the file:// null origin) get CORS
# headers. The mobile app sends no Origin and is not affected.
CORS_ALLOWED_ORIGINS=https://<console host>

# 1: the client IP for rate limits is the entry of X-Forwarded-For appended by the nearest proxy (the last
# one; TRUSTED_PROXY_HOPS = how many proxies, default 1). Leave off unless a proxy you control sets that
# header.
# TRUST_PROXY=1

# Secret of the Razorpay webhook (POST /webhook/razorpay, URL registered in the Razorpay dashboard). The
# signature is checked on the raw request body; when unset the webhook answers 503 (fail closed). Read on
# every call.
RAZORPAY_WEBHOOK_SECRET=<razorpay webhook secret>

# ============================================================================================================
# 4. BRAND, INVOICES AND E-MAIL CONTENT
# Unset values are simply left out of invoices and e-mails; nothing is invented.
# ============================================================================================================

# Product name used in the OpenAPI title, GET / text, OTP e-mail subject/body, suggestion e-mail, invoice item
# names, invoice e-mail title and download file names (default Clockyn). All brand/contact/seller strings are
# read through utils/branding.py.
# APP_NAME=Clockyn

# Contact details shown in the OTP e-mail and the invoice e-mail footer. Unset values are simply left out
# (default empty).
# SUPPORT_EMAIL=<support address>
# SUPPORT_URL=<support page url>
# WEBSITE_URL=<website url>

# Store listings: GET /version/check returns them as store_url when the app_version_control row has a NULL or
# empty store_url (read on every call; unset gives null), and the link in the WhatsApp staff invitation
# (Android first, then iOS, then WEBSITE_URL).
# ANDROID_STORE_URL=<play store listing url>
# IOS_STORE_URL=<app store listing url>

# Legal entity printed on invoice PDFs and invoice e-mails. SELLER_NAME defaults to APP_NAME; the rest default
# to empty (line left out). SELLER_ADDRESS separates lines with ; or a literal \n. Owner/finance decision:
# legal text on a tax invoice.
# SELLER_NAME=<legal entity name>
# SELLER_ADDRESS=<line 1>;<line 2>
# SELLER_GSTIN=<gstin>
# SELLER_CIN=<cin>
# SELLER_EMAIL=<billing e-mail>
# SELLER_PHONE=<phone>

# SAC code on invoice items (default 998314) and the Place of Supply text (default empty, shown as N/A).
# SELLER_SAC=998314
# SELLER_PLACE_OF_SUPPLY=<state (code)>

# File name inside static/ for the invoice logo (default brand_logo.png). When the file is missing the PDF
# shows the product initials. Invoices carry no signature image: they print "This is system generated invoice,
# no sign required".
# BRAND_LOGO_FILE=brand_logo.png

# Logo in the header of the welcome e-mail. EMAIL_LOGO_FILE is a file name inside static/ (default
# email_logo.png); when the file exists it is attached inline to the e-mail. EMAIL_LOGO_URL is an https://
# address of a hosted logo; when set it wins and nothing is attached. When neither is available the header
# shows a text wordmark.
# EMAIL_LOGO_FILE=email_logo.png
# EMAIL_LOGO_URL=

# 1 (or true / yes / on) turns on the one-time welcome e-mail to a company admin, sent the first time the
# admin's Home screen loads after registering (default off: nothing is sent and nothing is queried).
# WELCOME_EMAIL_ENABLED=0

# ============================================================================================================
# 5. PUSH, WHATSAPP, FACE RECOGNITION AND ADS
# ============================================================================================================

# Firebase FCM V1 (all push goes through services/push_service.py; FCM_PRIVATE_KEY keeps \n escapes). Not
# configured = push is silently disabled (logged once), never an error. Local fallback:
# FCM_SERVICE_ACCOUNT_PATH (service-account JSON file).
# FCM_PROJECT_ID=<firebase project id>
# FCM_CLIENT_EMAIL=<service account e-mail>
# FCM_PRIVATE_KEY=<private key, keep the \n escapes>
# FCM_PRIVATE_KEY_ID=<key id>
# FCM_CLIENT_ID=<client id>

# Android notification channel id (default attendance_notifications, the channel the app creates). Read on
# every send.
# FCM_ANDROID_CHANNEL_ID=attendance_notifications

# WhatsApp invites. MSG91_WHATSAPP_TEMPLATE has no default: the template must be approved at the provider
# under the current product name; when it is unset (or no app link is configured) invitations are skipped and
# a warning is logged.
# MSG91_WHATSAPP_AUTH_KEY=<msg91 whatsapp auth key>
# MSG91_WHATSAPP_NUMBER=<whatsapp number>
# MSG91_WHATSAPP_TEMPLATE=<approved template name>

# Face recognition backend (ml/face_service.py): rekognition (default, AWS Rekognition collection) or mock
# (deterministic stand-in for local development / browser tests: any decodable image is one face; it matches
# when the SHA-256 of the first 64 KB equals an enrolled photo of that user, state in memory;
# FACE_BACKEND=rekognition

# AWS Rekognition region (default AWS_S3_REGION, else ap-south-1) and collection id (default clockyn-faces).
# The collection and the IAM permissions are created by the owner: python scripts/rekognition_setup.py check /
# create / policy (see project_complete_context/domains/face_recognition_punch.md, "AWS Rekognition setup").
# REKOGNITION_REGION=ap-south-1
# REKOGNITION_COLLECTION_ID=clockyn-faces

# Match threshold as Rekognition similarity 0..100 (default 90.0): a punch matches when the best face of that
# user scores >= it. Replaces the cosine FACE_SIMILARITY_THRESHOLD; the stored face_attempt_log.score is
# similarity / 100. Read on every call; invalid values fall back to 90.
# REKOGNITION_THRESHOLD=90.0

# Meta Conversions API (optional)
# META_ACCESS_TOKEN=<meta access token>
# META_PIXEL_ID=<meta pixel id>

# ============================================================================================================
# 6. TUNING AND FEATURE FLAGS (ALL OPTIONAL)
# Defaults are the README values; change only with a reason.
# ============================================================================================================

# 1/true/yes/on: DELETE /company/delete-account/{id} anonymises the account in place in ONE transaction (names
# -> Deleted user, placeholder mobile / e-mail, device and push tokens cleared, bank / identity details
# blanked, leads' customer contacts blanked, company rows blanked, S3 photos removed after the commit) and
# keeps every row and reference (planner D-14).
# ACCOUNT_DELETE_ANONYMISE=0

# APP_APP_STORE_LINK=

# Deployment environment name. production / prod makes FACE_BACKEND=mock refuse to start. Nothing else reads
# it.
# APP_ENV=production

# APP_PLAY_STORE_LINK=

# In-process cache (default 30 s, 0 = off) of the per-user revocation epoch / status / role / organisation, of
# owners of ids and of manager permissions. A bump made by this process drops the entry at once; another
# process notices within this time.
# AUTH_EPOCH_CACHE_SECONDS=30

# Token lifetime in days (default 90 = the device-token lifetime; values outside 1..3650 fall back to 90).
# AUTH_TOKEN_TTL_DAYS=

# 0/false/no/off turns off the check that org_id belongs to the admin calling POST /orders/quote /
# /orders/create (org_info.parent_id or the admin's own users.org_id). Default on.
# BILLING_ENFORCE_ORG_OWNER=1

# Maximum size of a chat attachment in MB (default 25; any file type).
# CHAT_UPLOAD_MAX_MB=25

# 1/true/yes: approving a carry-forward request removes the staff's assignment (older behaviour, lead becomes
# unassigned). Default off: approval moves the lead's due date and the same staff keeps it with work status
# pending. Read on every call (core_functions/leads_functions.py).
# CRM_CARRY_FORWARD_UNASSIGN=0

# Rupees per km used by payroll (payroll_engine.default_odometer_rate) and by the odometer approve /
# allowance-rate endpoints when neither the reading nor the organisation (org_allowance_rate) has a rate.
# Default 3 (the app's default); set 1 to restore the legacy payroll fallback. Invalid / non-positive values
# fall back to 3.
# DEFAULT_ODOMETER_RATE=3

# 1/true/yes/on: server-side manager scope, deny by default (planner D-10): the home staff lists, the
# dashboard counts and GET /managers/{id}/staff show a manager only themselves, the staff assigned to them
# (users.manager_id) and, when manager_assignments rows exist, the staff of those branches AND departments
# (today a manager without assignments is unrestricted).
# ENFORCE_MANAGER_SCOPE=0

# 1/true/yes/on: managers and staff keep one device. POST /auth/validate-otp (purpose=login) answers 409
# device_mismatch for a login from a device that is not the active one (a device-change request is filed for
# the admin instead of the old OTP take-over); admins stay multi-device. Default off = the OTP take-over of
# today.
# ENFORCE_SINGLE_DEVICE=0

# FACE_PRECHECK (unset = on for Rekognition, off for FACE_BACKEND=mock; 1 / 0 force it): photos that cannot
# contain a face (shorter side < 80 px, mean luminance < 10, or one flat colour) are refused locally as
# no_face before any paid Rekognition call.
# FACE_ANTISPOOF=0

# core_functions/face_metrics.py: how many face operations (local decode + Rekognition calls) run at once per
# instance (default 8, 1..16; was 2 for the CPU-bound local model) and 0/false/no/off stops writing
# face_attempt_log rows (default on).
# FACE_ATTEMPT_LOG=1

# Face photo quality gates (ml/face_quality.py): minimum mean luminance 0..255 (default 45), minimum Laplacian
# variance (default 40), minimum shorter image side in px (default 200).
# FACE_BLUR_THRESHOLD=40
# FACE_DARK_THRESHOLD=45

# core_functions/face_metrics.py: how many face operations (local decode + Rekognition calls) run at once per
# instance (default 8, 1..16; was 2 for the CPU-bound local model) and 0/false/no/off stops writing
# face_attempt_log rows (default on).
# FACE_MAX_CONCURRENCY=8

# Width in px the decoded photo is downscaled to for the local quality numbers (ml/face.py, default 640,
# 160..2048, read once at start-up). The photo sent to Rekognition is separate (longest side 1920 px). The old
# FACE_DET_SIZE no longer exists.
# FACE_MAX_WIDTH=640

# Face photo quality gates (ml/face_quality.py): minimum mean luminance 0..255 (default 45), minimum Laplacian
# variance (default 40), minimum shorter image side in px (default 200).
# FACE_MIN_SIDE=200

# 1/true/yes/on with FACE_BACKEND=mock: every decodable photo matches any user (no photo hashing). Development
# only.
# FACE_MOCK_ALWAYS_MATCH=0

# FACE_PRECHECK (unset = on for Rekognition, off for FACE_BACKEND=mock; 1 / 0 force it): photos that cannot
# contain a face (shorter side < 80 px, mean luminance < 10, or one flat colour) are refused locally as
# no_face before any paid Rekognition call.
# FACE_PRECHECK=

# Deprecated, ignored (old cosine threshold 0..1 of the local model): when set, a warning is logged and
# REKOGNITION_THRESHOLD applies.
# FACE_SIMILARITY_THRESHOLD=

# FCM_SERVICE_ACCOUNT_PATH=

# Lifetime of the operator session token returned by POST /auth/admin-login/verify-otp (access_token,
# token_type Bearer, expires_in) in hours (default 12; values outside 1..72 fall back to 12).
# OPERATOR_TOKEN_TTL_HOURS=

# 1/true/yes enables the hard-coded store-review phone numbers that accept the static code 123456
# (USER_AUTH=otp only). Default off; read on every call; a startup warning is logged when it is on. Never
# enable in production.
# OTP_BYPASS=0

# POST /auth/generate-otp throttle per contact (phone or lower-cased email, both channels, every purpose): at
# most OTP_MAX_PER_HOUR codes per rolling hour (default 5) and at least OTP_MIN_GAP_SECONDS between two codes
# (default 30). Violations answer HTTP 429 before anything is sent; invalid values fall back to the defaults.
# OTP_MAX_PER_HOUR=5
# OTP_MIN_GAP_SECONDS=30

# 0/false/off switches every rate limit off (default on). Limits are in memory and PER INSTANCE (N instances =
# N times the limit; a restart resets them).
# RATE_LIMIT_ENABLED=1

# 1/true/yes/on: create the collection automatically when Rekognition reports it missing (needs
# rekognition:CreateCollection, which the least-privilege app role does not have). Default off: a missing
# collection is a clear configuration error in the log.
# REKOGNITION_AUTO_CREATE=0

# botocore retry attempts for Rekognition calls (mode standard, throttling and 5xx; default 3, 1..10). Connect
# / read timeouts are 5 s / 10 s.
# REKOGNITION_MAX_RETRIES=3

# 1/true/yes/on: POST /requests/update-status answers 403 (404 for another organisation's request) unless
# action_by is an admin of the request's organisation or a manager with Requests Management whose assignments
# cover the requester.
# REQUESTS_ENFORCE_ACTOR=0

# 1/true/yes makes app.py apply pending migrations/NNN_*.sql at start-up (same function as python migrate.py
# --all; an error is logged and never stops the app). Default off. PGSSLMODE and other libpq variables are
# honoured by the DB connections.
# RUN_MIGRATIONS=0

# Lifetime of the signed invoice download links (/invoice/history download_url, default 900, 60..86400);
# signed with AUTH_TOKEN_SECRET.
# SIGNED_URL_TTL_SECONDS=900

# TRUSTED_PROXY_HOPS=1

# Maximum size of an uploaded image / receipt in MB (default 10): 413 above it; the file type is read from the
# first bytes (png, jpeg, webp, gif, pdf), 415 otherwise.
# UPLOAD_MAX_MB=10

# Per-endpoint rate limits (count/window_seconds, or off); the rules and defaults are in the README (RATE_LIMIT_<RULE>).
# RATE_LIMIT_AUTH_LOGIN=30/60
